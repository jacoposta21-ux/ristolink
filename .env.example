# =====================================================================
# EasySito — variabili d'ambiente
# Copia in .env.local per lo sviluppo. Su Vercel: Project → Settings →
# Environment Variables (separando Production / Preview / Development).
# =====================================================================

# ---------- Dominio ----------
# Dominio base dei siti: i clienti saranno <slug>.easysito.com, la dashboard admin.easysito.com
# In locale usa "localhost:3000" → http://admin.localhost:3000, http://damario.localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# (opzionale) altri host da trattare come la home, separati da virgola
EXTRA_ROOT_HOSTS=
# (opzionale) altri host che aprono la dashboard admin, es. l'URL *.vercel.app del progetto
ADMIN_HOSTS=

# ---------- Supabase (Project Settings → API Keys) ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# chiave pubblica: "Publishable key" (sb_publishable_...) oppure la vecchia "anon" key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# chiave segreta SOLO lato server: "Secret key" (sb_secret_...) oppure la vecchia "service_role"
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# ---------- Stripe ----------
# Lavora in TEST finché tutto funziona: chiavi sk_test_ / price di test.
# In produzione sostituisci con sk_live_ e il price LIVE (sono oggetti diversi!).
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# Firma del webhook: in locale la stampa `stripe listen` (whsec_...),
# in produzione la trovi su Developers → Webhooks → endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
# Prezzo ricorrente 9,99 €/mese IVA inclusa (price_...), vedi README / `npm run stripe:setup`
STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxx
# (opzionale) configurazione del Customer Portal dedicata a EasySito (bpc_...);
# vuoto = portale predefinito dell'account
STRIPE_PORTAL_CONFIG_ID=

# ---------- Cron di riconciliazione ----------
# Stringa casuale lunga (es. `openssl rand -hex 32`). Vercel la invia come "Authorization: Bearer ..."
CRON_SECRET=cambia-questa-stringa-casuale

# ---------- Email promemoria (opzionale, https://resend.com) ----------
# Senza chiave vengono inviate solo le email automatiche di Stripe.
RESEND_API_KEY=
EMAIL_FROM="EasySito <noreply@easysito.com>"
# Ricevi una mail a ogni cambio di stato importante (in ritardo, sospeso, ...)
ADMIN_NOTIFY_EMAIL=

# ---------- Vercel API (opzionale) ----------
# Per aggiungere/verificare in automatico i domini personalizzati dei clienti.
# Token: vercel.com/account/tokens · Project ID: Project → Settings → General
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
# solo se il progetto è in un Team
VERCEL_TEAM_ID=

# ---------- Landing easysito.com ----------
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
# es. "Mario Rossi — P. IVA 01234567890"
NEXT_PUBLIC_COMPANY_INFO=
